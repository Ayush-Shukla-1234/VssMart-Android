    <!-- Help & Feedback Screen -->
    <string name="help_feedback_title">Help &amp; Support</string>
    <string name="faq_title">Frequently Asked Questions</string>
    <string name="faq_1_q">How does buying work on VssMart?</string>
    <string name="faq_1_a">Browse items in the Market tab, open any listing you like, and tap "Chat on WhatsApp". You can inspect the item in their hostel room and pay via UPI in person.</string>
    <string name="faq_2_q">Is there any commission or listing fee?</string>
    <string name="faq_2_a">No! VssMart is 100% free and open for college campus students. There are zero platform fees or transaction cuts.</string>
    <string name="faq_3_q">How do I mark an item as sold?</string>
    <string name="faq_3_a">Go to the "You" tab, find your item under "My Listings", and tap "Mark as Sold".</string>
