<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface_light"
    app:strokeColor="@color/divider_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <!-- Item Thumbnail -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivItemThumb"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@color/surface_variant_light"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toTopOf="@id/dividerActions"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small"
            tools:src="@drawable/ic_image_placeholder" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvMyItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toStartOf="@id/tvMyItemStatus"
            app:layout_constraintStart_toEndOf="@id/ivItemThumb"
            app:layout_constraintTop_toTopOf="@id/ivItemThumb"
            tools:text="Symphony Diet 3D Cooler" />

        <!-- Status Tag (Active / Sold) -->
        <TextView
            android:id="@+id/tvMyItemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_category_badge"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivItemThumb"
            tools:text="ACTIVE" />

        <!-- Price -->
        <TextView
            android:id="@+id/tvMyItemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/ivItemThumb"
            app:layout_constraintTop_toBottomOf="@id/tvMyItemTitle"
            tools:text="₹3,200" />

        <!-- Category & Location -->
        <TextView
            android:id="@+id/tvMyItemSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ivItemThumb"
            app:layout_constraintTop_toBottomOf="@id/tvMyItemPrice"
            tools:text="Coolers • Pulaha Rm 204" />

        <!-- Divider -->
        <View
            android:id="@+id/dividerActions"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/divider_stroke"
            app:layout_constraintTop_toBottomOf="@id/ivItemThumb" />

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/dividerActions">

            <!-- Toggle Sold Status Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleSold"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:text="@string/mark_as_sold"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

            <!-- Delete Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteListing"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/btn_delete"
                android:textColor="@color/sold_red"
                android:textSize="12sp"
                app:icon="@drawable/ic_delete"
                app:iconSize="16dp"
                app:iconTint="@color/sold_red" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
